# MCR AI Workforce - web dashboard
# Copy to .env.local for local development. All variables are server-only;
# nothing here is exposed to the browser (no NEXT_PUBLIC_ variables are used).

# Base URL of the backend API as reachable from the Next.js server
# (inside Docker this is usually the service name, e.g. http://api:8000).
API_INTERNAL_URL=http://localhost:8000

# Optional. The session cookie is "Secure" when NODE_ENV=production.
# Set to "false" only if the production build is served over plain HTTP
# (e.g. a LAN demo without TLS). Leave unset otherwise.
# SESSION_COOKIE_SECURE=false

# MCR AI Workforce — environment template for the Docker Compose stack.
# Copy to .env (development) or .env.prod (production). NEVER commit real values.
# Generate secrets:  cd apps/api ; uv run python -m app.cli generate-secrets

# --- infrastructure ---------------------------------------------------------
POSTGRES_USER=mcr
POSTGRES_DB=mcr
# required, long random string
POSTGRES_PASSWORD=
MINIO_ROOT_USER=mcr
# required, at least 8 characters
MINIO_ROOT_PASSWORD=
S3_BUCKET=mcr-artifacts
# required, long random string (encrypts credentials stored inside n8n)
N8N_ENCRYPTION_KEY=

# --- application security -----------------------------------------------------
# required, >= 32 random characters
JWT_SECRET=
# required, Fernet key (encrypts provider API keys stored in the database)
SECRETS_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000

# --- first administrator (used by `python -m app.cli seed`) ----------------------
BOOTSTRAP_ORG_NAME=MCR Technology
BOOTSTRAP_ADMIN_EMAIL=
# >= 10 characters; remove from the file after the first login
BOOTSTRAP_ADMIN_PASSWORD=

# --- behaviour --------------------------------------------------------------------
# true: when no AI provider is configured, agents emit clearly labelled DEMO placeholders.
# false (default; always false in production): those tasks fail with PROVIDER_NOT_CONFIGURED.
DEMO_MODE=false

# --- cloud AI (OpenAI or any OpenAI-compatible endpoint) -----------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Model for captions (empty: OPENAI_MODEL). gpt-4.1 writes better Thai; GPT-5.x is not supported yet.
OPENAI_CONTENT_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voice of the dashboard assistant (a female-sounding voice of your speech provider)
ASSISTANT_TTS_VOICE=nova
# The price table used for cost tracking and budgets lives in apps/api/app/config.py
# (LLM_INPUT_USD_PER_1M, LLM_OUTPUT_USD_PER_1M, IMAGE_USD_PER_IMAGE, TTS_USD_PER_1K_CHARS).
# Check it against your provider's current prices and override via environment variables.

# --- local AI (ComfyUI on the host GPU) -------------------------------------------------
# From containers the Windows host is reachable as host.docker.internal, e.g.
# COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_URL=

# Adobe Firefly Services (optional cloud image provider). Usually configured in Settings → AI providers
# instead. Needs a Firefly Services entitlement and an Adobe Developer Console project with an
# OAuth Server-to-Server credential. Never commit real values.
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
# Blank = Adobe's default (image3). image4_standard / image4_ultra have a native 9:16 size.
FIREFLY_MODEL_VERSION=
# Estimate used for budgets and usage reports; Adobe bills in operations under your contract.
FIREFLY_USD_PER_IMAGE=0.04
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# --- n8n completion notification (optional incoming-webhook URL) -----------------------------
MCR_NOTIFY_WEBHOOK_URL=

# --- Quote-to-Cash events to n8n (signed with HMAC-SHA256) ------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (at least 32 characters)
# Empty: events are recorded but not delivered. The API and n8n read the same value.
QTC_EVENTS_SECRET=
# QTC_EVENTS_URL=http://n8n:5678/webhook/mcr-qtc
# Links in team notifications
MCR_APP_URL=http://localhost:3000

# --- production only (compose.prod.yaml) ------------------------------------------------------
# ENVIRONMENT=production
# APP_VERSION=0.1.0
# APP_DOMAIN=app.example.com
# N8N_DOMAIN=n8n.example.com
# N8N_PROTOCOL=https
# N8N_WEBHOOK_URL=https://n8n.example.com/
# CORS_ORIGINS=https://app.example.com
# SESSION_COOKIE_SECURE=true
# Pin exact image tags or digests that you have verified exist:
# POSTGRES_IMAGE=postgres:<exact version>-alpine
# REDIS_IMAGE=redis:<exact version>-alpine
# MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:<digest>
# N8N_IMAGE=n8nio/n8n:<exact version>
# CADDY_IMAGE=caddy:<exact version>-alpine

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "apps/api",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "comfyui",
      "runtimeExecutable": "C:\\ComfyUI\\.venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "C:\\ComfyUI\\main.py",
        "--listen",
        "127.0.0.1",
        "--port",
        "8188"
      ],
      "port": 8188
    }
  ]
}
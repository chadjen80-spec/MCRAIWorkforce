<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in "game" for demos and end-to-end tests: records that it was started, then exits. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mcr-demo-game</AssemblyName>
  </PropertyGroup>

</Project>

      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "mcr-ai-workforce",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_AFTER_IMPORT",
          "name": "MCR Webhook Auth"
        }
      },
      "webhookId": "mcr-ai-workforce"
    },
    {
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst errors = [];\nconst command = typeof b.command === 'string' ? b.command.trim() : (typeof b.prompt === 'string' ? b.prompt.trim() : '');\nif (command.length < 5 || command.length > 4000) errors.push('command must be 5-4000 characters');\nconst allowed = ['content', 'image', 'document', 'video'];\nconst agents = Array.isArray(b.agents) && b.agents.length ? [...new Set(b.agents)] : allowed;\nif (agents.some(a => !allowed.includes(a))) errors.push('agents must be a subset of ' + allowed.join(', '));\nconst budget = b.budget_limit_usd === undefined ? null : Number(b.budget_limit_usd);\nif (budget !== null && !(budget > 0 && budget <= 1000)) errors.push('budget_limit_usd must be between 0 and 1000');\nconst language = b.language === 'en' ? 'en' : 'th';\nconst aspect_ratio = b.aspect_ratio === '9:16' ? '9:16' : '16:9';\nconst requestId = typeof b.request_id === 'string' && b.request_id.length <= 100 ? b.request_id : $execution.id;\nconst payload = { command, agents, language, aspect_ratio, auto_start: false,\n  require_approval: b.require_approval !== false,\n  data_classification: ['public', 'internal', 'restricted'].includes(b.data_classification) ? b.data_classification : 'internal' };\nif (budget !== null) payload.budget_limit_usd = budget;\nreturn [{ json: { valid: errors.length === 0, errors, payload, idempotency_key: 'n8n-' + requestId } }];"
      }
    },
    {
      "id": "input-valid",
      "name": "Input Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,

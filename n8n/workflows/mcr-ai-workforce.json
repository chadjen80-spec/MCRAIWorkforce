    {
      "id": "content-agent",
      "name": "Content Agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        20
      ],
      "parameters": {
        "jsCode": "// Observes the Celery-backed tasks of one agent. n8n does not run the agent: the queue does.\nconst terminal = ['succeeded','failed','skipped','cancelled'];\nconst tasks = $('Get Tasks').first().json.items.filter(t => t.agent === 'content');\nconst count = s => tasks.filter(t => t.status === s).length;\nreturn [{ json: { agent: 'content', total: tasks.length, succeeded: count('succeeded'), failed: count('failed'),\n  running: count('running'), queued: count('queued') + count('pending'),\n  done: tasks.every(t => terminal.includes(t.status)),\n  providers: [...new Set(tasks.map(t => t.provider).filter(Boolean))] } }];"
      }
    },
    {
      "id": "image-agent",
      "name": "Image Agent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        170
      ],
      "parameters": {
        "jsCode": "// Observes the Celery-backed tasks of one agent. n8n does not run the agent: the queue does.\nconst terminal = ['succeeded','failed','skipped','cancelled'];\nconst tasks = $('Get Tasks').first().json.items.filter(t => t.agent === 'image');\nconst count = s => tasks.filter(t => t.status === s).length;\nreturn [{ json: { agent: 'image', total: tasks.length, succeeded: count('succeeded'), failed: count('failed'),\n  running: count('running'), queued: count('queued') + count('pending'),\n  done: tasks.every(t => terminal.includes(t.status)),\n  providers: [...new Set(tasks.map(t => t.provider).filter(Boolean))] } }];"

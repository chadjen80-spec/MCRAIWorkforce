      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4220,
        220
      ],
      "parameters": {
        "jsCode": "const p = $('Job Progress').last().json;\nconst qa = $input.first().json;\nconst warnings = (qa.checks || []).filter(c => c.status !== 'pass').map(c => c.name + ': ' + c.detail);\nconst text = p.timed_out\n  ? `MCR AI Workforce: job ${p.job_id} is still ${p.status} after ${p.polls} checks. It keeps running; see the dashboard.`\n  : `MCR AI Workforce: job ${p.job_id} finished with status ${p.status}` + (p.demo_mode ? ' (DEMO output, not AI-generated)' : '')\n    + `. QA: ${qa.verdict || 'n/a'}.` + (p.status === 'awaiting_approval' ? ' Approval is required in the dashboard.' : '');\nreturn [{ json: { job_id: p.job_id, status: p.status, timed_out: p.timed_out, demo_mode: p.demo_mode, qa_verdict: qa.verdict,\n  qa_summary: qa.summary, warnings, agents: p.agents, text } }];"
      }
    },
